{
  "manifest_version": 3,
  "name": "Seriecita",
  "version": "1.0.4",
  "description": "구글 플레이북스 라이브러리에서 같은 시리즈의 책들을 자동으로 묶어서 보여줍니다.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Seriecita"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://play.google.com/books*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
