{
  "manifest_version": 3,
  "name": "Seriecita",
  "version": "1.3.0",
  "description": "구글 플레이북스 라이브러리에서 같은 시리즈의 책들을 자동으로 묶어서 보여줍니다.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    },
    "default_title": "Seriecita"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["storage", "notifications", "alarms"],
  "host_permissions": ["https://api.github.com/*", "https://www.googleapis.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://play.google.com/books*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
